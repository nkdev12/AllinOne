{
  "name": "allinone-backend",
  "version": "0.1.0",
  "description": "Production-grade backend for Allinone - cross-platform personal information management",
  "author": "Allinone Team",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:backup": "./scripts/test-backup-restore.sh",
    "test:dr": "./scripts/test-backup-restore.sh",
    "test:load:sync": "k6 run test/load/k6-sync-load.js",
    "test:load:auth": "k6 run test/load/k6-auth-load.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "sync:backfill:cursor": "ts-node scripts/backfill-change-cursor.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@nestjs/bull": "^11.0.5",
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/platform-socket.io": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.2.6",
    "@prisma/client": "^5.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "bull": "^4.16.5",
    "class-transformer": "^0.5",
    "class-validator": "^0.14",
    "google-auth-library": "^11.0.2",
    "helmet": "^7.0",
    "ioredis": "^5.0",
    "joi": "^17.11",
    "jsonwebtoken": "^9.0",
    "nodemailer": "^10.0.0",
    "otplib": "^13.5.0",
    "passport": "^0.7",
    "passport-jwt": "^4.0",
    "passport-local": "^1.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1",
    "rimraf": "^5.0",
    "rxjs": "^7.8",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.6",
    "@types/express": "^4.17",
    "@types/jest": "^29.5",
    "@types/node": "^20.10",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^3.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^6.13",
    "@typescript-eslint/parser": "^6.13",
    "eslint": "^8.55",
    "eslint-config-prettier": "^9.0",
    "eslint-plugin-prettier": "^5.0",
    "jest": "^29.7",
    "prettier": "^3.1",
    "prisma": "^5.0",
    "supertest": "^6.3",
    "ts-jest": "^29.1",
    "ts-loader": "^9.5",
    "ts-node": "^10.9",
    "tsconfig-paths": "^4.2",
    "typescript": "^5.3"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.9"
    },
    "@typescript-eslint/utils": {
      "minimatch": "^9.0.9"
    },
    "uuid": "^11.1.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test/finance"
    ],
    "testRegex": ".*(\\.|_)(spec|test)\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!(@scure|@noble|otplib|@otplib)/)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
