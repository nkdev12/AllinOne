# ============================================================================
# Allinone Backend Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================================================
# Application
# ============================================================================
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=debug

# ============================================================================
# Database (MongoDB)
# ============================================================================
# Format: mongodb://host:port/database
# The server must run as replica set member (mongod --replSet rs0); transactions
# used by sync/vault services fail against a standalone instance.
DATABASE_URL="mongodb://localhost:27017/allinone_dev"

# ============================================================================
# Redis
# ============================================================================
REDIS_URL=redis://localhost:6379

# ============================================================================
# Cross-origin policy (HTTP API and the /sync WebSocket)
# ============================================================================
# Two separate lists, because they answer two separate handshakes.
#
# CORS_ORIGIN is the HTTP API's, read by app.enableCors() in src/main.ts. It
# defaults to http://localhost:3000 when unset. Comma-separated for several
# origins.
# CORS_ORIGIN=http://localhost:3000
#
# WS_CORS_ORIGINS is the /sync namespace's, built at boot by SyncIoAdapter
# (src/sync/adapters/sync-io.adapter.ts). Unset, it falls through to
# CORS_ORIGINS, then CORS_ORIGIN, then the same http://localhost:3000 — so a
# deployment that configured the HTTP app is not left with an open socket. Set
# it when the web client is served from a different origin than the API.
#
# The list is never quietly widened: the only way a socket accepts any origin is
# to write * into it yourself, and * is then answered with credentials disabled
# (a browser rejects the two together).
# WS_CORS_ORIGINS=http://localhost:3000
#
# A request with no Origin header, or a literal `Origin: null`, is what a
# WebView-hosted or non-browser client sends. Off by default; the answer to "my
# web build cannot connect" is to name its origin above, not to switch this on.
# WS_CORS_ALLOW_NULL_ORIGIN=false
#
# Socket.IO rooms live in one process unless a pub/sub backplane joins them, so
# with more than one API replica a device on replica B misses what replica A
# emitted. Clustering is attempted when REDIS_URL is set and switched off by
# WS_REDIS_ADAPTER=false. A Redis that is configured but unreachable costs one
# connect timeout at boot and falls back to in-memory, like the throttler does.
# WS_REDIS_ADAPTER=true

# ============================================================================
# Authentication & JWT
# ============================================================================
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# ============================================================================
# Admin access (/admin/*) — fails closed, opt in explicitly
# ============================================================================
# AdminGuard admits a caller only through the three values below, and an unset
# or empty value means NO admin access via that mechanism. There is
# deliberately no working example address here: registration creates an ACTIVE
# user without proving the address, so any address published in a committed
# template is an identity a stranger can claim first.
# Comma-separated emails, matched against the authenticated user's address.
# ADMIN_EMAILS=
# Comma-separated user ids (User.id), matched exactly.
# ADMIN_USER_IDS=
# Break-glass for operator tooling, sent as `x-admin-secret: <value>`. It
# escalates an already-authenticated request only — it is not an identity by
# itself — and the header path stays disabled unless the value is at least 32
# characters.
# ADMIN_SECRET=

# ============================================================================
# Object Storage (S3-compatible)
# ============================================================================
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=allinone-dev
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_USE_SSL=false

# ============================================================================
# OAuth Providers
# ============================================================================
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=

OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# ============================================================================
# Email (SMTP - use Mailpit for development, your own SMTP for production)
# ============================================================================
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@allinone.local
SMTP_TLS=false
EMAIL_VERIFY_ENABLED=false
EMAIL_VERIFY_TOKEN_EXPIRY=24h

# ============================================================================
# Encryption (Application-level, change in production)
# ============================================================================
ENCRYPTION_KEY=your-super-secret-encryption-key-min-32-chars-change-prod

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# Throttling is off by default when APP_ENV=development or NODE_ENV=test, so
# without this the limits the controllers declare are never exercised locally.
RATE_LIMIT_ENABLED=false
# Lets a request skip throttling with `x-skip-throttle: true`. Honoured outside
# production only, and off by default: a client must not choose its own limit.
RATE_LIMIT_HEADER_BYPASS=false

# ============================================================================
# Logging (Structured JSON to stdout, collected by Docker/journald/Loki)
# ============================================================================
LOG_FORMAT=json
LOG_LEVEL=info

# ============================================================================
# Monitoring (Prometheus - open-source, self-hosted)
# ============================================================================
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# ============================================================================
# OpenTelemetry (Optional - Jaeger, Loki integration)
# ============================================================================
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ============================================================================
# Backup Configuration
# ============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * * # 2 AM daily
BACKUP_RETENTION_DAYS=30
# Read by scripts/backup-database.sh: when set, the dump is encrypted to
# *.archive.gz.enc and the plaintext archive is deleted - including when
# encryption itself fails. Restore needs the same value. Unset, the dump stays
# plaintext, which includes the VaultSetting collection.
# BACKUP_PASSPHRASE=
# Both scripts source this file first if it exists, and refuse it unless its
# mode has no group/other bits (chmod 600), so the passphrase never appears in
# a crontab, a shell history or `ps`.
BACKUP_ENV_FILE=/etc/allinone/backup.env
# Optional second location for the finished archive, verified with cmp and
# pruned on the same retention clock. Same-disk is not disaster recovery -
# point it at another volume or a mounted share.
# BACKUP_COPY_DIR=
# Nothing consumes BACKUP_ENABLED or BACKUP_SCHEDULE yet - see docs/DEPLOYMENT.md
# Step 8 for the cron line that runs the script on a schedule.

# ============================================================================
# AI Summarization (Google Gemini) - optional, opt in explicitly
# ============================================================================
# GEMINI_API_KEY is the only switch here. Unset or blank - including
# whitespace-only - means /ai/summarize answers from its deterministic local
# heuristics and no request is ever sent to Google, so the feature degrades
# instead of failing. Set it to a Google AI Studio key to route summarization
# through Gemini; extract-tasks and suggest-tags stay heuristic either way.
# The key travels in the x-goog-api-key header, never in the URL.
GEMINI_API_KEY=
# Model used for the call when a key is configured.
GEMINI_MODEL=gemini-1.5-flash
# Per-request deadline in milliseconds. A timeout is logged and then answered by
# the same local heuristics, so keep this well under the caller's patience.
GEMINI_TIMEOUT_MS=5000
