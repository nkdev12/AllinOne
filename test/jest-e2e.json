{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "diagnostics": {
          "ignoreCodes": [151002]
        }
      }
    ]
  },
  "testEnvironment": "node",
  "transformIgnorePatterns": [
    "node_modules/(?!(@scure|@noble|otplib|@otplib)/)"
  ],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1"
  }
}

