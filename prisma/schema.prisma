// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Users & Authentication
// ============================================================================

model User {
  id                String   @id @default(uuid()) @map("_id")
  email             String   @unique
  displayName       String?
  avatar            String?
  locale            String   @default("en-US")
  timezone          String   @default("UTC")
  status            UserStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  failedLoginAttempts Int      @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  // Relations
  authentications   Authentication[]
  devices           Device[]
  sessions          Session[]
  mfaSettings       MFASetting?
  auditLogs         AuditLog[]
  folders           Folder[]
  tags              Tag[]
  notes             Note[]
  projects          Project[]
  tasks             Task[]
  reminders         Reminder[]
  calendars         Calendar[]
  events            Event[]
  vaultSetting      VaultSetting?
  vaultItems        VaultItem[]
  emailVerificationOtp EmailVerificationOtp?

  @@index([status])
  @@index([createdAt])
}

model EmailVerificationOtp {
  id        String   @id @default(uuid()) @map("_id")
  userId    String   @unique
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

model Authentication {
  id                String   @id @default(uuid()) @map("_id")
  userId            String
  type              AuthType
  identifier        String
  passwordHash      String?
  emailVerified     Boolean  @default(false)
  lastUsedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, identifier])
  @@index([userId])
  @@index([type])
}

enum AuthType {
  EMAIL_PASSWORD
  GOOGLE
  APPLE
  MICROSOFT
  PASSKEY
}

model Session {
  id                String   @id @default(uuid()) @map("_id")
  userId            String
  deviceId          String
  accessToken       String   @unique
  refreshToken      String   @unique
  accessExpiresAt   DateTime
  refreshExpiresAt  DateTime
  revokedAt         DateTime?
  lastActivityAt    DateTime @default(now())
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device            Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
}

// ============================================================================
// Devices & Multi-Device Support
// ============================================================================

model Device {
  id                String   @id @default(uuid()) @map("_id")
  userId            String
  name              String
  platform          Platform
  appVersion        String
  osVersion        String?
  publicKey         String
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  revokedAt         DateTime?

  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions          Session[]
  syncStates        DeviceSyncState[]

  @@index([userId])
  @@index([platform])
}

enum Platform {
  IOS
  ANDROID
  MACOS
  WINDOWS
  LINUX
  WEB
}

model DeviceSyncState {
  id                String   @id @default(uuid()) @map("_id")
  deviceId          String   @unique
  lastPulledCursor  String?
  lastPushedSequence Int     @default(0)
  lastSuccessfulSyncAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  device            Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

// ============================================================================
// Multi-Factor Authentication
// ============================================================================

model MFASetting {
  id                String   @id @default(uuid()) @map("_id")
  userId            String   @unique
  totpEnabled       Boolean  @default(false)
  totpSecret        String?  // Encrypted at application level
  recoveryCodes     String?  // Encrypted JSON array of recovery codes
  backupCodesUsed   String?  // JSON array of used code indices
  lastVerifiedAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// Synchronization
// ============================================================================

model Change {
  id                String   @id @default(uuid()) @map("_id")
  userId            String
  deviceId          String?  // NULL for server-side changes
  entityType        String
  entityId          String
  operation         ChangeOperation
  version           Int
  payload           Json     // Contains only non-sensitive metadata
  cursor            BigInt   @default(0)
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([deviceId])
  @@index([userId, cursor])
  @@index([createdAt])
}

enum ChangeOperation {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

model IdempotencyKey {
  id                String   @id @default(uuid()) @map("_id")
  key               String   @unique
  userId            String
  endpoint          String
  method            String
  statusCode        Int
  response          Json
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================================
// Audit Logging
// ============================================================================

model AuditLog {
  id                String   @id @default(uuid()) @map("_id")
  userId            String?
  action            AuditAction
  resourceType      String?
  resourceId        String?
  requestId         String?
  changes           Json?
  ipAddress         String?
  userAgent         String?
  metadata          Json?
  createdAt         DateTime @default(now())

  // Relations
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([requestId])
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_CHANGED
  EMAIL_CHANGED
  MFA_ENABLED
  MFA_DISABLED
  DEVICE_ADDED
  DEVICE_REVOKED
  SESSION_REVOKED
  ACCOUNT_CREATED
  ACCOUNT_DELETED
  ACCOUNT_EXPORTED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  OAUTH_CONNECTED
  OAUTH_REVOKED
}

// ============================================================================
// Notes & Content Management
// ============================================================================

model Folder {
  id          String   @id @default(uuid()) @map("_id")
  userId      String
  parentId    String?
  name        String
  color       String?
  icon        String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Folder[] @relation("FolderHierarchy")
  notes       Note[]

  @@index([userId])
  @@index([parentId])
}

model Tag {
  id          String   @id @default(uuid()) @map("_id")
  userId      String
  name        String
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteTags    NoteTag[]
  taskLabels  TaskLabel[]

  @@unique([userId, name])
  @@index([userId])
}

model Note {
  id          String   @id @default(uuid()) @map("_id")
  userId      String
  folderId    String?
  title       String
  content     String?
  isPinned    Boolean  @default(false)
  isArchived  Boolean  @default(false)
  isEncrypted Boolean  @default(false)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  noteTags    NoteTag[]
  history     NoteHistory[]
  attachments Attachment[]

  @@index([userId])
  @@index([folderId])
  @@index([updatedAt])
}

model NoteTag {
  id          String   @id @default(uuid()) @map("_id")
  noteId      String
  tagId       String
  createdAt   DateTime @default(now())

  // Relations
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag         Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([noteId, tagId])
  @@index([noteId])
  @@index([tagId])
}

model NoteHistory {
  id          String   @id @default(uuid()) @map("_id")
  noteId      String
  version     Int
  title       String
  content     String?
  createdAt   DateTime @default(now())

  // Relations
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
}

model Attachment {
  id          String   @id @default(uuid()) @map("_id")
  noteId      String
  userId      String
  filename    String
  mimeType    String
  size        Int
  storagePath String
  checksum    String?
  createdAt   DateTime @default(now())

  // Relations
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([userId])
}

// ============================================================================
// Tasks & Todo Management
// ============================================================================

enum TaskPriority {
  P1_URGENT
  P2_HIGH
  P3_MEDIUM
  P4_LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReminderChannel {
  NOTIFICATION
  EMAIL
}

model Project {
  id          String   @id @default(uuid()) @map("_id")
  userId      String
  name        String
  description String?
  color       String?
  icon        String?
  sortOrder   Int      @default(0)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections    Section[]
  tasks       Task[]

  @@index([userId])
}

model Section {
  id          String   @id @default(uuid()) @map("_id")
  projectId   String
  name        String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId])
}

model Task {
  id             String       @id @default(uuid()) @map("_id")
  userId         String
  projectId      String?
  sectionId      String?
  parentId       String?
  title          String
  description    String?
  priority       TaskPriority @default(P4_LOW)
  status         TaskStatus   @default(TODO)
  dueDate        DateTime?
  dueTime        String?
  recurrenceRule String?
  completedAt    DateTime?
  sortOrder      Int          @default(0)
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  // Relations
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section        Section?     @relation(fields: [sectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent         Task?        @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subtasks       Task[]       @relation("TaskSubtasks")
  taskLabels     TaskLabel[]
  reminders      Reminder[]

  @@index([userId])
  @@index([projectId])
  @@index([sectionId])
  @@index([parentId])
  @@index([dueDate])
  @@index([status])
}

model TaskLabel {
  id          String   @id @default(uuid()) @map("_id")
  taskId      String
  tagId       String
  createdAt   DateTime @default(now())

  // Relations
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag         Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId])
  @@index([taskId])
  @@index([tagId])
}

model Reminder {
  id          String          @id @default(uuid()) @map("_id")
  taskId      String
  userId      String
  remindAt    DateTime
  isSent      Boolean         @default(false)
  channel     ReminderChannel @default(NOTIFICATION)
  createdAt   DateTime        @default(now())

  // Relations
  task        Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([remindAt])
}

// ============================================================================
// Calendar & Events Management
// ============================================================================

enum CalendarProvider {
  LOCAL
  GOOGLE
  MICROSOFT
  ICAL
}

enum EventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum AttendeeStatus {
  NEEDS_ACTION
  ACCEPTED
  DECLINED
  TENTATIVE
}

model Calendar {
  id               String           @id @default(uuid()) @map("_id")
  userId           String
  name             String
  description      String?
  color            String?
  timeZone         String           @default("UTC")
  isPrimary        Boolean          @default(false)
  isPublic         Boolean          @default(false)
  externalProvider CalendarProvider @default(LOCAL)
  externalId       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  // Relations
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  events           Event[]

  @@index([userId])
}

model Event {
  id             String          @id @default(uuid()) @map("_id")
  userId         String
  calendarId     String
  title          String
  description    String?
  location       String?
  startAt        DateTime
  endAt          DateTime
  isAllDay       Boolean         @default(false)
  recurrenceRule String?
  status         EventStatus     @default(CONFIRMED)
  color          String?
  version        Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendar       Calendar        @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  attendees      EventAttendee[]
  reminders      EventReminder[]

  @@index([userId])
  @@index([calendarId])
  @@index([startAt, endAt])
}

model EventAttendee {
  id          String         @id @default(uuid()) @map("_id")
  eventId     String
  email       String
  displayName String?
  status      AttendeeStatus @default(NEEDS_ACTION)
  isOrganizer Boolean        @default(false)
  createdAt   DateTime       @default(now())

  // Relations
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([email])
}

model EventReminder {
  id            String          @id @default(uuid()) @map("_id")
  eventId       String
  userId        String
  minutesBefore Int             @default(15)
  channel       ReminderChannel @default(NOTIFICATION)
  createdAt     DateTime        @default(now())

  // Relations
  event         Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
}

// ============================================================================
// Zero-Knowledge Password Vault
// ============================================================================

enum VaultItemType {
  LOGIN
  SECURE_NOTE
  CREDIT_CARD
  IDENTITY
  PASSWORD
}

model VaultSetting {
  id                String   @id @default(uuid()) @map("_id")
  userId            String   @unique
  masterKeyHash     String
  keySalt           String
  kdfIterations     Int      @default(100000)
  kdfMemory         Int?     @default(65536)
  isVaultConfigured Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VaultItem {
  id            String        @id @default(uuid()) @map("_id")
  userId        String
  type          VaultItemType @default(LOGIN)
  name          String
  category      String?
  encryptedData String
  iv            String
  authTag       String
  isFavorite    Boolean       @default(false)
  version       Int           @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  // Relations
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([category])
}
