// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Users & Authentication
// ============================================================================

model User {
  id                String   @id @default(uuid()) @map("_id")
  email             String   @unique
  displayName       String?
  avatar            String?
  locale            String   @default("en-US")
  timezone          String   @default("UTC")
  status            UserStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  failedLoginAttempts Int      @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  // Relations
  authentications   Authentication[]
  devices           Device[]
  sessions          Session[]
  mfaSettings       MFASetting?
  auditLogs         AuditLog[]
  folders           Folder[]
  tags              Tag[]
  notes             Note[]
  projects          Project[]
  tasks             Task[]
  reminders         Reminder[]
  calendars         Calendar[]
  events            Event[]
  vaultSetting      VaultSetting?
  emailVerificationOtp EmailVerificationOtp?
  otpTokens        OtpToken[]
  // Collaboration grants: the resources this account shares out, and the ones it
  // was given access to. Back-relations for `ResourceShare`.
  ownedShares       ResourceShare[] @relation("ResourceShareOwner")
  receivedShares    ResourceShare[] @relation("ResourceShareGrantee")

  // Finance relations
  financeAccounts        FinanceAccount[]
  financeCategories      FinanceCategory[]
  financeTransactions    FinanceTransaction[]
  financeBudgets         FinanceBudget[]
  financeSavingsGoals    FinanceSavingsGoal[]
  financeRecurringRules  FinanceRecurringRule[]
  financeLoans           FinanceLoan[]
  financeOwnedGroups     FinanceGroup[]
  financeOwnedTrips      FinanceTrip[]

  @@index([status])
  @@index([createdAt])
}

model EmailVerificationOtp {
  id        String   @id @default(uuid()) @map("_id")
  userId    String   @unique
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("email_verification_otps")
}

// Out-of-band identity codes for password reset and vault recovery. Keyed by
// purpose so a code issued for one flow can never be spent on the other.
model OtpToken {
  id        String     @id @default(uuid()) @map("_id")
  userId    String
  purpose   OtpPurpose
  codeHash  String
  attempts  Int        @default(0)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose])
  @@index([expiresAt])
}

enum OtpPurpose {
  PASSWORD_RESET
  VAULT_RECOVERY
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

model Authentication {
  id                String   @id @default(uuid()) @map("_id")
  userId            String
  type              AuthType
  identifier        String
  passwordHash      String?
  emailVerified     Boolean  @default(false)
  lastUsedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, identifier])
  @@index([userId])
  @@index([type])
}

enum AuthType {
  EMAIL_PASSWORD
  GOOGLE
  APPLE
  MICROSOFT
  PASSKEY
}

model Session {
  id                String   @id @default(uuid()) @map("_id")
  userId            String
  deviceId          String
  accessToken       String   @unique
  refreshToken      String   @unique
  accessExpiresAt   DateTime
  refreshExpiresAt  DateTime
  revokedAt         DateTime?
  lastActivityAt    DateTime @default(now())
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device            Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
}

// ============================================================================
// Devices & Multi-Device Support
// ============================================================================

model Device {
  id                String   @id @default(uuid()) @map("_id")
  userId            String
  name              String
  platform          Platform
  appVersion        String
  osVersion        String?
  publicKey         String
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  revokedAt         DateTime?

  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions          Session[]
  syncStates        DeviceSyncState[]

  @@index([userId])
  @@index([platform])
}

enum Platform {
  IOS
  ANDROID
  MACOS
  WINDOWS
  LINUX
  WEB
}

model DeviceSyncState {
  id                String   @id @default(uuid()) @map("_id")
  deviceId          String   @unique
  lastPulledCursor  String?
  lastPushedSequence Int     @default(0)
  lastSuccessfulSyncAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  device            Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

// ============================================================================
// Multi-Factor Authentication
// ============================================================================

model MFASetting {
  id                String   @id @default(uuid()) @map("_id")
  userId            String   @unique
  totpEnabled       Boolean  @default(false)
  totpSecret        String?  // Encrypted at application level
  recoveryCodes     String?  // Encrypted JSON array of recovery codes
  backupCodesUsed   String?  // JSON array of used code indices
  lastVerifiedAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// Synchronization
// ============================================================================

model Change {
  id                String   @id @default(uuid()) @map("_id")
  userId            String
  deviceId          String?  // NULL for server-side changes
  entityType        String
  entityId          String
  operation         ChangeOperation
  version           Int
  payload           Json     // note/task/event content, or opaque vault ciphertext
  cursor            BigInt   @default(0)
  createdAt         DateTime @default(now())
  // When the authoring device made the edit, stamped on its clock. `createdAt`
  // is when this server heard about it, which for a device that was offline for
  // a week is a week later — and clients sort their lists on the edit. Stored
  // and echoed, never compared: conflict refusal is by `version` alone, so an
  // ahead-of-clock device cannot push its way past a newer write.
  clientTimestamp   DateTime?

  @@index([userId])
  @@index([deviceId])
  @@index([userId, cursor])
  @@index([createdAt])
}

// Per-user high-water mark for `Change.cursor`. MongoDB has no sequence object
// and Prisma exposes no way to derive "one greater than anything this user has
// ever been handed" from the Change collection itself without a max() scan that
// races concurrent writers, so the counter lives in its own document and is
// advanced with an atomic $inc inside the same interactive transaction that
// writes the Change row. Two concurrent pushes therefore serialise on this
// document instead of handing the same cursor to two rows.
model SyncCursor {
  id        String   @id @default(uuid()) @map("_id")
  userId    String   @unique
  seq       BigInt   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ChangeOperation {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

model IdempotencyKey {
  id                String   @id @default(uuid()) @map("_id")
  key               String
  userId            String
  endpoint          String
  method            String
  statusCode        Int
  response          Json
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  // Scoped per account: a globally unique key made one account's cached response
  // addressable by anybody who held the string, and the write path that reuses an
  // unknown key overwrites the row it collided with — including its userId.
  @@unique([userId, key])
  @@index([userId])
  @@index([expiresAt])
}

// ============================================================================
// Audit Logging
// ============================================================================

model AuditLog {
  id                String   @id @default(uuid()) @map("_id")
  userId            String?
  action            AuditAction
  resourceType      String?
  resourceId        String?
  requestId         String?
  changes           Json?
  ipAddress         String?
  userAgent         String?
  metadata          Json?
  createdAt         DateTime @default(now())

  // Relations
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([requestId])
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_CHANGED
  EMAIL_CHANGED
  MFA_ENABLED
  MFA_DISABLED
  DEVICE_ADDED
  DEVICE_REVOKED
  SESSION_REVOKED
  ACCOUNT_CREATED
  ACCOUNT_DELETED
  ACCOUNT_EXPORTED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  OAUTH_CONNECTED
  OAUTH_REVOKED
  // Collaboration grants. `/collaboration` used to borrow DEVICE_ADDED /
  // DEVICE_REVOKED because this enum had no share member, which made every SIEM
  // query for device enrolment drag in resource shares too. Additive, so rows
  // already written keep their old values; the enum is plain strings on MongoDB.
  RESOURCE_SHARED
  RESOURCE_SHARE_REVOKED
}

// ============================================================================
// Notes & Content Management
// ============================================================================

model Folder {
  id        String   @id @default(uuid()) @map("_id")
  userId    String
  parentId  String?
  name      String
  color     String?
  icon      String?
  // Which of the desktop app's note formats a note created in this folder gets:
  // the same stable key `Note.noteType` holds (`normal`, `diary`, `shopping`,
  // `bucket`, `quotes`), and held for the same three reasons — it is the app's
  // name rather than a label, it is not closed to the five the current build
  // knows, and `icon` is the folder's own glyph so a type's default icon stays
  // the app's to change.
  //
  // `version` is the folder's position in the change log, mirrored from the
  // accepted change the way `Note.version` is. A folder syncs as a whole
  // document, so without a number to compare an edit still queued on another
  // device would arrive as the newest word on its name.
  type      String?
  version   Int      @default(1)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Folder[] @relation("FolderHierarchy")
  notes       Note[]

  @@index([userId])
  @@index([parentId])
}

model Tag {
  id          String   @id @default(uuid()) @map("_id")
  userId      String
  name        String
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteTags    NoteTag[]
  taskLabels  TaskLabel[]

  @@unique([userId, name])
  @@index([userId])
}

model Note {
  id          String   @id @default(uuid()) @map("_id")
  userId      String
  folderId    String?
  title       String
  content     String?
  isPinned    Boolean  @default(false)
  isArchived  Boolean  @default(false)
  isEncrypted Boolean  @default(false)
  // The desktop client's own label list and highlight colour, kept under exactly
  // the key names the client's Isar schema and `toMap()` write, because a sync
  // payload is matched by name and renaming one loses the user's tags.
  //
  // `tags` is a list of bare strings rather than the normalised `NoteTag` join
  // this row also carries: a device typing a label into the note has no tag UUID
  // to point at, so the join cannot hold what it sends. The two are different
  // state and neither is derived from the other.
  //
  // Both read back safely on rows written before they existed: a list defaults to
  // empty, and `color` is nullable, so no document has to be rewritten.
  tags        String[] @default([])
  color       String?
  // The same client-authored pair, one level down: which of the desktop app's
  // note formats a note is, and the rows its table holds.
  //
  // `noteType` is the format's stable key (`normal`, `diary`, `shopping`,
  // `bucket`, `quotes`) rather than a label, so a rename in the app's UI is not
  // a migration here. `structured` is the JSON text the client serialises, and
  // the server holds it as opaque text for the reason the vault holds its blob
  // opaquely: the row's shape is the app's to evolve, and re-shaping it on the
  // way through would drop anything this server has not been taught about yet.
  //
  // Both are nullable rather than defaulted: a note written before the format
  // existed has no type to invent, and an absent `structured` means "this note
  // has no table" in a way a `{"rows":[]}` — a table the user cleared — does
  // not. `null` is the value that distinction needs, so it stays a value here.
  noteType    String?
  structured  String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  noteTags    NoteTag[]
  history     NoteHistory[]
  attachments Attachment[]

  @@index([userId])
  @@index([folderId])
  @@index([updatedAt])
}

model NoteTag {
  id          String   @id @default(uuid()) @map("_id")
  noteId      String
  tagId       String
  createdAt   DateTime @default(now())

  // Relations
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag         Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([noteId, tagId])
  @@index([noteId])
  @@index([tagId])
}

model NoteHistory {
  id          String   @id @default(uuid()) @map("_id")
  noteId      String
  version     Int
  title       String
  content     String?
  createdAt   DateTime @default(now())

  // Relations
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
}

model Attachment {
  id          String   @id @default(uuid()) @map("_id")
  noteId      String
  userId      String
  filename    String
  mimeType    String
  size        Int
  storagePath String
  checksum    String?
  createdAt   DateTime @default(now())

  // Relations
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([userId])
}

// ============================================================================
// Tasks & Todo Management
// ============================================================================

enum TaskPriority {
  P1_URGENT
  P2_HIGH
  P3_MEDIUM
  P4_LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReminderChannel {
  NOTIFICATION
  EMAIL
}

model Project {
  id          String   @id @default(uuid()) @map("_id")
  userId      String
  name        String
  description String?
  color       String?
  icon        String?
  sortOrder   Int      @default(0)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections    Section[]
  tasks       Task[]

  @@index([userId])
}

model Section {
  id          String   @id @default(uuid()) @map("_id")
  projectId   String
  name        String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId])
}

model Task {
  id             String       @id @default(uuid()) @map("_id")
  userId         String
  projectId      String?
  sectionId      String?
  parentId       String?
  title          String
  description    String?
  priority       TaskPriority @default(P4_LOW)
  status         TaskStatus   @default(TODO)
  dueDate        DateTime?
  dueTime        String?
  recurrenceRule String?
  completedAt    DateTime?
  sortOrder      Int          @default(0)
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  // Relations
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section        Section?     @relation(fields: [sectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent         Task?        @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subtasks       Task[]       @relation("TaskSubtasks")
  taskLabels     TaskLabel[]
  reminders      Reminder[]

  @@index([userId])
  @@index([projectId])
  @@index([sectionId])
  @@index([parentId])
  @@index([dueDate])
  @@index([status])
}

model TaskLabel {
  id          String   @id @default(uuid()) @map("_id")
  taskId      String
  tagId       String
  createdAt   DateTime @default(now())

  // Relations
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag         Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId])
  @@index([taskId])
  @@index([tagId])
}

model Reminder {
  id          String          @id @default(uuid()) @map("_id")
  taskId      String
  userId      String
  remindAt    DateTime
  isSent      Boolean         @default(false)
  channel     ReminderChannel @default(NOTIFICATION)
  createdAt   DateTime        @default(now())

  // Relations
  task        Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([remindAt])
}

// ============================================================================
// Calendar & Events Management
// ============================================================================

enum CalendarProvider {
  LOCAL
  GOOGLE
  MICROSOFT
  ICAL
}

enum EventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum AttendeeStatus {
  NEEDS_ACTION
  ACCEPTED
  DECLINED
  TENTATIVE
}

model Calendar {
  id               String           @id @default(uuid()) @map("_id")
  userId           String
  name             String
  description      String?
  color            String?
  timeZone         String           @default("UTC")
  isPrimary        Boolean          @default(false)
  isPublic         Boolean          @default(false)
  externalProvider CalendarProvider @default(LOCAL)
  externalId       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  // Relations
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  events           Event[]

  @@index([userId])
}

model Event {
  id             String          @id @default(uuid()) @map("_id")
  userId         String
  calendarId     String
  title          String
  description    String?
  location       String?
  startAt        DateTime
  endAt          DateTime
  isAllDay       Boolean         @default(false)
  recurrenceRule String?
  status         EventStatus     @default(CONFIRMED)
  color          String?
  version        Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendar       Calendar        @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  attendees      EventAttendee[]
  reminders      EventReminder[]

  @@index([userId])
  @@index([calendarId])
  @@index([startAt, endAt])
}

model EventAttendee {
  id          String         @id @default(uuid()) @map("_id")
  eventId     String
  email       String
  displayName String?
  status      AttendeeStatus @default(NEEDS_ACTION)
  isOrganizer Boolean        @default(false)
  createdAt   DateTime       @default(now())

  // Relations
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([email])
}

model EventReminder {
  id            String          @id @default(uuid()) @map("_id")
  eventId       String
  userId        String
  minutesBefore Int             @default(15)
  channel       ReminderChannel @default(NOTIFICATION)
  createdAt     DateTime        @default(now())

  // Relations
  event         Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
}

// ============================================================================
// Password Vault
// ============================================================================

model VaultSetting {
  id                String   @id @default(uuid()) @map("_id")
  userId            String   @unique
  // base64(SHA-256(...)) of the verifier the client derived, wrapped in
  // hmac-sha256 under the server-only ENCRYPTION_KEY. Stored as anything else
  // it would be a bearer secret: holding it is holding the unlock.
  masterKeyHash     String
  keySalt           String
  // What the client derived with, recorded for diagnostics and read by nothing:
  // the authoritative copy of these parameters is the `_kdf` marker sealed
  // inside every vault blob. `t = 3` / `m = 65536` KiB are the values the
  // shipped client sends; the 100000 this column defaulted to was a PBKDF2-shaped
  // placeholder from before a client existed, so rows written before it carry
  // that number and nothing should be read into it.
  kdfIterations     Int      @default(3)
  kdfMemory         Int?     @default(65536)
  isVaultConfigured Boolean  @default(true)

  // Master-password recovery: recoveryKey wraps the master key so an
  // OTP-verified reset can rewrap the stable data key instead of
  // destroying it. The trade-off is that the server now holds material that
  // can recover any vault, so this is no longer zero-knowledge.
  recoveryKey       String?
  wrappedMasterKey  String?
  wrappedMasterIv   String?
  wrappedMasterTag  String?
  // Password-derived key wraps the stable data key after password recovery.
  // Missing fields denote the legacy password-derived data key format.
  passwordWrappedKey String?
  passwordWrappedIv  String?
  passwordWrappedTag String?
  // Set when a recovery OTP is spent; the password wrapper must be stored
  // before this deadline, otherwise the recovery grant expires.
  recoveryGrantedAt DateTime?
  // Failed master-password verifications, counted here and never on `User`: a
  // wrong *master password* must not lock the *account* out of its notes,
  // tasks and calendar.
  unlockFailedAttempts Int       @default(0)
  // While this is in the future the unlock endpoint refuses without even
  // comparing the verifier.
  unlockLockedUntil    DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// Collaboration & Resource Sharing
// ============================================================================

enum ShareRole {
  VIEWER
  EDITOR
  ADMIN
}

enum ShareResourceType {
  NOTE
  PROJECT
  CALENDAR
  EXPENSE_GROUP
  TRIP
}

// One role granted on one resource to one recipient.
//
// This row is the reason `/collaboration` can carry collaboration at all: the
// service kept grants in `private readonly shares = new Map()` — process memory,
// lost on every restart, invisible to other workers, and with nothing but an
// audit-log entry as a trace. `sharedWithUserId` is required, which is the schema
// refusing the old email-only invite: a grant with no user behind it can never be
// matched by `checkAccess(userId, …)` and silently granted nothing.
//
// `resourceType`/`resourceId` is polymorphic (note, project, calendar), so the
// resource side cannot carry a foreign key and is resolved by the service before
// a grant is written. The two user sides can, and do.
model ResourceShare {
  id               String            @id @default(uuid()) @map("_id")
  resourceType     ShareResourceType
  resourceId       String
  ownerId          String
  sharedWithUserId String
  sharedWithEmail  String
  role             ShareRole         @default(VIEWER)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  // Relations
  owner            User              @relation("ResourceShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sharedWith       User              @relation("ResourceShareGrantee", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  // The duplicate-share rule, enforced where two racing requests can both lose
  // or both win: the service used to `find` over the map first, and nothing
  // stopped concurrent callers from both missing. Revoked grants keep their row
  // (`deletedAt`), so a collision on this key is read back by the service and
  // either revived — a re-share with the same person — or answered with `409`.
  @@unique([resourceType, resourceId, sharedWithEmail])
  @@index([resourceType, resourceId])
  @@index([sharedWithUserId])
  @@index([sharedWithEmail])
  @@index([ownerId])
}

// ============================================================================
// Finance & Money Manager Module
// ============================================================================

enum FinanceAccountType {
  CASH
  BANK
  WALLET
  CREDIT
  INVESTMENT
  SAVINGS
  OTHER
}

enum FinanceTransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum FinanceBudgetPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum FinanceRecurringFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum FinanceLoanType {
  LENT
  BORROWED
}

enum FinanceSplitType {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
  ITEMIZED
}

model FinanceAccount {
  id                  String             @id @default(uuid()) @map("_id")
  userId              String
  name                String
  type                FinanceAccountType @default(BANK)
  currency            String             @default("INR")
  openingBalanceMinor BigInt             @default(0)
  currentBalanceMinor BigInt             @default(0)
  color               String?
  iconKey             String?
  isArchived          Boolean            @default(false)
  sortOrder           Int                @default(0)
  deletedAt           DateTime?
  version             Int                @default(1)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[] @relation("AccountTransactions")
  transfersIn  FinanceTransaction[] @relation("TransferToAccount")

  @@index([userId, deletedAt])
  @@map("finance_accounts")
}

model FinanceCategory {
  id        String                 @id @default(uuid()) @map("_id")
  userId    String?
  name      String
  type      FinanceTransactionType @default(EXPENSE)
  iconKey   String?
  color     String?
  parentId  String?
  isSystem  Boolean                @default(false)
  deletedAt DateTime?
  version   Int                    @default(1)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  user         User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]
  budgets      FinanceBudget[]

  @@index([userId, type, deletedAt])
  @@map("finance_categories")
}

model FinanceTransaction {
  id                   String                 @id @default(uuid()) @map("_id")
  userId               String
  accountId            String
  toAccountId          String?
  categoryId           String?
  type                 FinanceTransactionType
  amountMinor          BigInt
  currency             String                 @default("INR")
  title                String
  notes                String?
  tags                 String[]               @default([])
  transactionDate      DateTime
  receiptAttachmentId  String?
  recurringRuleId      String?
  sharedExpenseId      String?
  isExcludedFromBudget Boolean                @default(false)
  deletedAt            DateTime?
  version              Int                    @default(1)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     FinanceAccount   @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  toAccount   FinanceAccount?  @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  category    FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, transactionDate])
  @@index([accountId, deletedAt])
  @@map("finance_transactions")
}

model FinanceBudget {
  id              String              @id @default(uuid()) @map("_id")
  userId          String
  categoryId      String?
  amountMinor     BigInt
  period          FinanceBudgetPeriod @default(MONTHLY)
  startDate       DateTime?
  endDate         DateTime?
  alertAt80       Boolean             @default(true)
  alertAt100      Boolean             @default(true)
  alertSentAt     DateTime?
  deletedAt       DateTime?
  version         Int                 @default(1)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, deletedAt])
  @@map("finance_budgets")
}

model FinanceSavingsGoal {
  id                 String    @id @default(uuid()) @map("_id")
  userId             String
  name               String
  targetAmountMinor  BigInt
  currentAmountMinor BigInt    @default(0)
  targetDate         DateTime?
  color              String?
  iconKey            String?
  isCompleted        Boolean   @default(false)
  deletedAt          DateTime?
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@map("finance_savings_goals")
}

model FinanceRecurringRule {
  id              String                    @id @default(uuid()) @map("_id")
  userId          String
  accountId       String
  categoryId      String?
  type            FinanceTransactionType
  amountMinor     BigInt
  title           String
  frequency       FinanceRecurringFrequency @default(MONTHLY)
  interval        Int                       @default(1)
  startDate       DateTime
  endDate         DateTime?
  nextDueDate     DateTime
  lastGeneratedAt DateTime?
  autoGenerate    Boolean                   @default(true)
  deletedAt       DateTime?
  version         Int                       @default(1)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextDueDate, deletedAt])
  @@map("finance_recurring_rules")
}

model FinanceLoan {
  id                   String          @id @default(uuid()) @map("_id")
  userId               String
  type                 FinanceLoanType
  counterpartyName     String
  counterpartyContact  String?
  principalAmountMinor BigInt
  remainingAmountMinor BigInt
  dueDate              DateTime?
  notes                String?
  isSettled            Boolean         @default(false)
  deletedAt            DateTime?
  version              Int             @default(1)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isSettled, deletedAt])
  @@map("finance_loans")
}

model FinanceGroup {
  id          String    @id @default(uuid()) @map("_id")
  ownerId     String
  name        String
  description String?
  currency    String    @default("INR")
  iconKey     String?
  isArchived  Boolean   @default(false)
  deletedAt   DateTime?
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner          User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sharedExpenses FinanceSharedExpense[]
  settlements    FinanceSettlement[]

  @@index([ownerId, deletedAt])
  @@map("finance_groups")
}

model FinanceSharedExpense {
  id                  String           @id @default(uuid()) @map("_id")
  groupId             String?
  tripId              String?
  paidByUserId        String
  payerAccountId      String?
  title               String
  totalAmountMinor    BigInt
  currency            String           @default("INR")
  splitType           FinanceSplitType @default(EQUAL)
  date                DateTime
  notes               String?
  receiptAttachmentId String?
  deletedAt           DateTime?
  version             Int              @default(1)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  group  FinanceGroup?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  trip   FinanceTrip?          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  shares FinanceExpenseShare[]

  @@index([groupId, deletedAt])
  @@index([tripId, deletedAt])
  @@map("finance_shared_expenses")
}

model FinanceExpenseShare {
  id              String    @id @default(uuid()) @map("_id")
  sharedExpenseId String
  userId          String
  owedAmountMinor BigInt
  shareUnits      Float?
  isSettled       Boolean   @default(false)
  settledAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sharedExpense FinanceSharedExpense @relation(fields: [sharedExpenseId], references: [id], onDelete: Cascade)

  @@index([sharedExpenseId, userId])
  @@map("finance_expense_shares")
}

model FinanceSettlement {
  id            String    @id @default(uuid()) @map("_id")
  groupId       String?
  tripId        String?
  fromUserId    String
  toUserId      String
  amountMinor   BigInt
  currency      String    @default("INR")
  date          DateTime
  notes         String?
  paymentMethod String?
  deletedAt     DateTime?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  group FinanceGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  trip  FinanceTrip?  @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([groupId, deletedAt])
  @@index([tripId, deletedAt])
  @@map("finance_settlements")
}

model FinanceTrip {
  id               String    @id @default(uuid()) @map("_id")
  ownerId          String
  title            String
  destinations     String[]  @default([])
  startDate        DateTime
  endDate          DateTime
  baseCurrency     String    @default("INR")
  totalBudgetMinor BigInt?
  notes            String?
  isArchived       Boolean   @default(false)
  deletedAt        DateTime?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner          User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  itineraryItems FinanceTripItinerary[]
  sharedExpenses FinanceSharedExpense[]
  settlements    FinanceSettlement[]

  @@index([ownerId, deletedAt])
  @@map("finance_trips")
}

model FinanceTripItinerary {
  id               String    @id @default(uuid()) @map("_id")
  tripId           String
  dayIndex         Int
  date             DateTime?
  title            String
  plannedCostMinor BigInt?
  notes            String?
  sortOrder        Int       @default(0)
  deletedAt        DateTime?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  trip FinanceTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, dayIndex])
  @@map("finance_trip_itineraries")
}
